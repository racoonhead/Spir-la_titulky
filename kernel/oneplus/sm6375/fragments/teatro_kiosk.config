# Konfigurační fragment jádra (kernel defconfig fragment) pro OnePlus Nord CE 4 Lite 5G (Qualcomm SM6375 / holi)
# Zajišťuje stabilní Wi-Fi přenos, podporu wakelocků, nízkou latenci WebSocketu a správu AMOLED panelu.

CONFIG_PM_WAKELOCKS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_INET=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y

